{
  "name": "shifra-nuha-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shifra Nuha Technologies internal CRM — Version 3",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/clean-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply shifra-nuha-crm --local",
    "db:migrate:remote": "wrangler d1 migrations apply shifra-nuha-crm --remote",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:leads": "tsx scripts/seed-leads.ts",
    "db:seed:customers": "tsx scripts/seed-customers.ts",
    "auth:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build && wrangler deploy --env staging"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tanstack/react-query": "5.105.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "5.20261104.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.157.0"
  }
}
